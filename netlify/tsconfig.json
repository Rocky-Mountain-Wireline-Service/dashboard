{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["functions/**/*.ts", "lib/**/*.ts", "../build/**/*.ts"]
}
