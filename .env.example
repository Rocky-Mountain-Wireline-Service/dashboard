# ── Browser (bundled into the app; nothing secret) ──────────────────────────
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# ── Server functions only (set in Netlify; never prefix with VITE_) ─────────

# Who may use the dashboard: comma-separated addresses and/or @domain entries.
# Leave empty only if sign-ups are disabled in the Auth0 tenant.
ALLOWED_EMAILS=

# Google Analytics 4 — a service account with Viewer access to the property.
# GA4_PROPERTY_ID is the numeric property ID, not the G-XXXX measurement ID.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
# GA4_TIMEZONE=America/Denver

# Support requests (Resend). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
SUPPORT_TO_EMAIL=
SUPPORT_FROM_EMAIL=

# Sanity — only needed if a content widget is enabled.
VITE_SANITY_PROJECT_ID=29kbekqj
VITE_SANITY_DATASET=staging

# Billing (Stripe). A restricted key is enough: read on customers, subscriptions,
# invoices and products; write on customer portal sessions. The customer portal
# must be switched on in Stripe: Settings -> Billing -> Customer portal.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=

# Content Kit — only needed if contentKit.enabled is true.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
